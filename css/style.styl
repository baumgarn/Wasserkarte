:root
	--borderstyle 1px solid #ccc
	--chartborderstyle 1px solid #00000015
	--chartborderradius 4px
	--sidebartextmargin 1px
	--borderstyle none
	--dropshadowfilter drop-shadow(0 2px 3px #00000022)
	--activecolor #b9d0eb
	--activecolordarker #899cb399
	--activecolorgrey #5275a055
	--activecolorgreyopaque #c5d1df
	--activecolorgreydarker #5275a088
	--activecolorgreymid #5275a033
	--activecolorgreybrighter #5275a022
	--activecolorgreybrightest #5275a011
	--menusectionheadercolor #4c88ccff
	--menusectionheadercolor rgb(68, 102, 188)
	--menusectionheadercolorlight rgba(68, 102, 188, 1)
	--menusectionheadercolorlighter rgba(68, 102, 188, 0.4)
	--menusectionheadercolorlightest rgba(68, 102, 188, 0.4)
	--warningred  #ea4545ee
	--windowbg #efefef
	--uibrighter #f7f7f7
	--menuactivebg #eaeaea88
	--menuinactivebg #eaeaea
	--menugrau #eee
	--menubariconsize 40px
	--separatorline 2px solid #00000011
	--thinline 1px solid #00000022
	--thinnerline 1px solid #e8e8e8
	--logogruen #008c46
	--logorot #f15f5c
	--infobg #33333388
	--infobg #22222288
	--timelineheight unquote("min( max( 4vh, 42px), 64px )")
	--timelineheightmobile unquote("max( 4vh, 64px)")
	--timelinedatebg #44444499
	--menuheaderline #00000022

body.is-mobile
	--timelineheight var(--timelineheightmobile)

*
	box-sizing border-box
	scrollbar-width: thin


html, body
	margin: 0;
	height: 100%;
	font-family: "Noto Sans", sans-serif;
	font-family: "Ubuntu", sans-serif;
	font-weight: 500;
	font-weight: 400;
	font-size: 11pt;
	line-height 1.3
	overscroll-behavior: none;
	color: #000000

a
	color: #000000ee

h1, h2, h3, h4, h5
	font-family: "Ubuntu", sans-serif;

.app-container
	position absolute
	right 0
	top 0
	bottom 0

#ui
#app
	visibility hidden

body.loaded
	#ui
	#app
		visibility visible

/////
#map
	position: absolute;
	top: 0;
	bottom: 0;
	left: 0;
	right: 0;

.ol-zoom
	right: 12px !important
	top: 24px !important
	left: unset !important;
	display none
	> *
		width 24px
		height 24px

.sidebaropen .ol-zoom
	right 612px !important

.ol-attribution
	font-family sans-serif
	opacity .8
	z-index 102
	top unset !important
	transform translate(100%, 0) rotate(-90deg)
	transform-origin 0 100%
	border-top-right-radius 6px !important
	border-top-left-radius 0 !important
	ul li
		font-size 7.5pt
		color #333
		a
			color #333
			&:hover
				text-decoration underline

.minimap .ol-attribution
	top unset !important
	bottom 0 !important
	border-top-left-radius 4px !important
	border-bottom-left-radius 0 !important

button.ol-zoom-in
button.ol-zoom-out
	font-size 1.3em

menuwidth = 250px

// UI LAYOUT

#app
#ui
	position absolute
	left 0
	top 0
	bottom 0
	right 0
	pointer-events none
	> *
		pointer-events all

.wrapper
	position fixed
	left 0
	top 0
	right 0
	bottom 0
	display flex
	flex-direction column

.mapareawrapper
	flex-grow 1
	z-index 0
	position relative

.timelinewrapper
	flex-grow 0
	z-index 1
	width 100%

.sidebaropen .mapareawrapper
.sidebaropen .timelinewrapper
.sidebaropen .tableview
	width calc( 100% - 600px )

#mapcontainer
.fullview
	pointer-events all

.topbar
	position fixed
	left 0
	top 0
	right 0
	display flex
	justify-content space-between
	pointer-events none
	> *
		pointer-events all

.is-mobile .topbar
	background: linear-gradient(to bottom, rgba(0, 0, 0, 0.05), transparent);
	flex-wrap wrap

.leftui
	position absolute
	left 0
	top var(--menubariconsize)
	margin-top 1px
	bottom 0
	pointer-events none
	display flex
	flex-direction column
	z-index 2
	> *
		pointer-events all

.is-mobile .leftui
	bottom 0
	z-index 11

// .leftui
// 	position fixed !important
// 	bottom 0
// 	z-index 1000 !important



// MENU WINDOW

.menuwindows
	pointer-events none
	flex-grow 1
	align-self flex-start
	overflow hidden

.menuwindow
	max-height 100%
	pointer-events all
	display flex
	flex-direction column
	background #fff
	box-shadow 2px 2px 4px 0 #00000022
	padding 0
	min-width 225px
	margin-right 6px

.is-mobile .menuwindow
	max-width 80vw !important

.menuwindow-header
	flex-grow 0
	flex-shrink 0
	display flex
	flex-direction row
	align-items center
	justify-content space-between
	height 42px
	padding 0 12px 0
	margin 0
	border-bottom var(--thinline)
	h3
		font-size 12pt
		color #000000bb
		margin 0 0 0

.menuwindow-content
	scrollbar-width none
	&::-webkit-scrollbar
		display none
	overflow-y auto
	overflow auto
	margin 0
	padding 6px 6px
	h4
		font-weight bold
		padding-top 6px
		margin 2em 4px .5em
		margin .5em 4px .5em
		display block
		color var(--menusectionheadercolor)
		font-size 80%
		font-size 9pt
		text-transform uppercase
		border-top var(--thinline)
	& > h4:first-of-type
		border-top none
		margin-top 0
		padding-top 6px
	.note
		// opacity .8
		font-size 9pt
		margin-bottom 6px
		em
			font-style normal
			// font-weight bold


// MENU ITEM

.menuitem
	cursor pointer
	width 100%
	margin 0 0
	padding 6px 6px
	min-height 28px
	border-radius 3px
	border-radius 14px
	font-size 9pt
	overflow hidden
	white-space nowrap
	text-overflow ellipsis
	user-select none

.menuitem.hasselectedbelow
	border-bottom-left-radius 0
	border-bottom-right-radius 0
.menuitem.selected + .menuitem.selected
	border-top-left-radius 0
	border-top-right-radius 0

.menuitem.selected
	background var(--activecolorgrey)

.menuwindow-button-row
	display flex
	gap 5px
	flex-direction row
	margin-right -5px

.menuwindow-button
	flex-grow 1
	flex-basis 0
	flex-shrink 0
	border-radius 5px
	background var(--uibrighter)
	border 1px solid #00000022
	border-top 1px solid #00000011
	box-shadow 0 0 2px 2px #00000011
	box-shadow 0 0 2px 2px #00000008
	padding 4px 5px
	white-space nowrap
	cursor pointer
	font-size 90%
	user-select none
	&.active
		background: var(--activecolor)
	&.icon:after
		content ''
		display inline-block
		width 1.1em
		height 1.1em
		margin-right .05em
		margin-left .3em
		margin-bottom -.2em
		background-repeat no-repeat
		background-position center
		background-size 100% 100%
	&.legende:after
	&.extended:after
		background-image url(/img/legende.png)
		opacity 1
	&.transparent:after
		background-size 80% 80%
		opacity .7
		background-image url(/img/transparentr.png)
	&.pinbookmarks:after
		background-size 100% 100%
		opacity .7
		background-image url(/img/pinned.svg)


.itemrow
	display: flex
	margin: 0
	flex-direction: row


@media (max-width: 600px)
	.itemrow
		gap .2em
		flex-direction column


// SETTINGS

.settings-group:first-of-type
	padding-top .4empx
.settings-group
	padding 8px 8px
	position relative
	font-size 12px
	label.small
		font-size 80%
		margin 0 0 4px
		// opacity .6
		cursor default
	.settingslabel
		margin 0 0 4px

.settings-group + .settings-group
	margin-bottom 10px

.settings-item
	margin 4px 0 0
.settings-item + .settings-item
	margin-top 8px


input[type=checkbox]
input[type=radio]
	width 14px
	height 14px
	margin 0
	position relative
	top 2px
	accent-color: #888
	cursor pointer
input[type=radio]
	top 1px

.settings-item
	input + label
		padding-left 6px
		cursor pointer
		display inline-block


button
	border none
	border-radius 1em
	height 2em
	min-width 8em
	padding 0 1em
	white-space nowrap
	width fit-content
	min-width: 120px
	align-self flex-start
	cursor pointer
	background var(--activecolorgrey)

button:has(> .icon)
	display inline-flex
	align-items center
	justify-content flex-start
	gap 6px
	text-align left
	padding-left .6em

button:disabled
	opacity .45
	cursor default

button:active:not(:disabled)
	background var(--activecolorgreydarker)

button.active:not(:disabled)
	background var(--activecolorgreybrighter)
	color #00000066
	.icon
		opacity .4


button.danger
button.warning
	background #f5d2d2 !important

button.success
	background #bde5c5

// button.active
	// background var(--activecolorgreydarker)

// MANAGEMENT


.split
	display flex
	justify-content space-between

.management-panel
	padding 14px

.management-window-size-mid
	box-sizing border-box
	width 400px
	max-width calc(100vw - 32px)

.management-form
	display grid
	gap 12px
	align-items start
	font-size 9pt

.management-field
	display grid
	gap 4px

.management-field input
.management-field select
.management-field textarea
	box-sizing border-box
	min-width 0
	padding 7px
	border 1px solid #00000033
	border-radius 4px
	background #fff
	font inherit

.management-readonly-value
	padding 7px
	border 1px solid #00000033
	border-radius 4px
	background #00000008

.management-field input:disabled
	background #f1f1f1
	color #555

.management-note
	margin 0
	padding 6px 8px
	border-radius 4px
	font-size 9pt
	line-height 1.4

.management-notice
	opacity .65
	background #00000008

.management-error
	color #b52323
	background #b5232314

.management-success
	color #177143
	background #17714314

.management-section-title
	margin 0
	font-size 11pt

.management-actions
	display flex
	flex-wrap wrap
	gap 8px
	align-items center

.spacebetween
	width 100%
	justify-content space-between

button.management-danger
	background #b52323
	color #fff

// FULL VIEW

.fullview
	background var(--windowbg)
	background #fff
	position fixed
	width 100vw
	height 100vh
	z-index 300

.fullview.iframe
	padding 10px 6px 0

.fullview.single
	padding 12px 0 48px
	overflow-y scroll

.fullview.embed
	.sideview
		margin-right 0


.fullview.embed
.fullview.qrcode
	.scrollcontent
		box-shadow -2px 0 4px #00000011 inset
		background var(--windowbg)
	.sideview
		border-right 1px solid #00000011
		z-index 10
		box-shadow 2px 0 4px #00000011


.fullviewheader
	background var(--windowbg)
	flex-grow 0
	flex-shrink 0
	min-height 80px
	border-bottom var(--separatorline)
	width 100%
	z-index 2
	display flex
	flex-direction row
	align-items center
	justify-content center

.windowrow
	display flex
	flex-direction row
	width 100%
	height 100%
	overflow hidden
	> .scrollcontent
		padding-right 36px

.windowcol
	display flex
	flex-direction column
	width 100%
	height 100%
	overflow hidden
	// padding-right 10px

.row
	display flex
	flex-direction row
.col
	display flex
	flex-direction column



// .sidebar .windowcol
	// padding-right 54px

.scrollcontent
	flex-grow 1
	overflow-y auto
	padding 0 0 0
	overflow-x hidden


// SIDEBAR

.sidebar
	pointer-events all
	background #fff
	position fixed
	right 0
	top 0
	bottom 0
	width 600px
	max-width 100%
	z-index 100
	box-shadow -2px 0 4px 0 #00000022
	box-shadow -3px 0 6px 0 #00000018
	overflow visible

.sidebar.fullwidth
	width 100vw

@media (max-width: 900px) // mobile full width sidebar
	.sidebar
		width 100vw
		z-index 300
		.windowrow .scrollcontent
			padding-right 0


// MODAL WINDOW


.modalouter
	position fixed
	left 0
	top 0
	right 0
	bottom 0
	display flex
	align-items center	// ← CENTER vertically when it fits!
	justify-content center
	pointer-events none
	z-index 200
	padding 0	// ← optional: give a little breathing room

.modalwindow
	width 800px
	height auto
	max-width calc(100vw - 2em)
	pointer-events all
	position relative
	margin 8px
	background var(--windowbg)
	box-shadow 0 1px 6px 0 #00000044

.modalinner
	max-height 100vh
	padding 0 32px
	overflow-y auto


.modalwindow.info
	background white



// WINDOW BUTTONS

.windowbuttons
	right 0
	top 0
	bottom 0
	margin 0
	width 36px
	padding 6px 0 8px 2px
	flex-grow 0
	display flex
	flex-direction column
	align-items center
	justify-content flex-start
	border-left 1px solid #eee
	position absolute

.windowbuttons.left
	right unset
	left 0
	padding 6px 2px 8px 0

.windowbuttons.row
	flex-direction row
	width unset
	height 36px
	gap 8px
	padding 0 6px 0 4px

.windowbuttons.row.left
	padding 0 0 0 4px

.windowbuttonsinner
	pointer-events all
	display flex
	flex-direction column
	gap 10px

.windowbuttons.plain
	background transparent
	box-shadow none
	border-left 1px solid transparent
	bottom unset
	&:after
		display none
.windowbuttons.small
	margin-top -2px
	margin-right -4px
	.iconbutton
		width 16px
		height 16px
		opacity .4
		&:hover
			opacity 1

@media (max-width: 900px)
	.windowbuttons
		background transparent
		box-shadow none
		bottom unset
		z-index 100
		border none
		&:after
		.switchfullwindow
		.more
			display none

.fullview .windowbuttons
	z-index 1000

.iconbutton
	width 24px
	height 24px
	background-size 100% 100%
	background-position center
	background-repeat no-repeat
	opacity .8
	transition opacity linear .05s
	position relative
	cursor pointer
	&:hover
		opacity .45

.iconbutton.light
	opacity .45
	&:hover
	&.active
		opacity .8

.iconbutton.bookmark
	background-image url(/img/bookmarkfill.svg)
	background-size 110%
	opacity .2
.iconbutton.bookmark.active
	opacity .8

.iconbutton.more
	background-image url(/img/morev.png)
.iconbutton.more
	background-image url(/img/morev.png)
.iconbutton.settings
	background-image url(/img/settings_black.png)
	background-size 105%
.iconbutton.filter
	background-image url(/img/filter_black.png)
	background-size 110%
.iconbutton.close
	background-image url(/img/close.png)
	background-size 120%
.iconbutton.switchfullwindow
	background-image url(/img/dock_left.png)
	background-size 94%
	background-size 90%
.sidebar.fullwidth .iconbutton.switchfullwindow
	background-image url(/img/dock_right.png)

// POPOVER

///

.separator
	display inline-block
	margin 0 .3em
	opacity .4

.separator::before
	content '-'

hr
	border none
	border-bottom var(--thinline)
	margin .8em var(--sidebartextmargin)

.chartouterframe
	margin 1.2em 0 .4em
	position relative
	user-select none
	.scrollframe
		background transparent

.chartheader
	padding-bottom 2px
	display flex
	align-items baseline
	justify-content space-between
	margin-top -.4em
	h3
		margin 0 0 .8em
		margin-left var(--sidebartextmargin)
		font-size 10pt
		color #000000bb
	.latestdate
		font-size 8pt
		font-weight bold
		font-weight normal
		margin-left 1em
		color #000000cc
		&.warning
			color red

.chart-time
	display block
	position relative

.heatmap .chart-time
	border-top 1px solid transparent
.schichten .chart-time
	border-top 1px solid #eee

.value
	font-weight bold
.unit
	display inline-block
	margin-left .15em

///


.hoverline
	position absolute
	top 0
	bottom 0
	width 0
	border-left 1px dotted #00000088
	pointer-events none
	z-index 100
