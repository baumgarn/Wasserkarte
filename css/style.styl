	width 20px
	height 20px
	border-radius 50%
	background #aaa
	border 1.5px solid #00000022
	filter: drop-shadow(0 1px 2px rgba(0,0,0,.2));
	pointer-events none
	font-size 12pt
	display flex
	align-items center
	justify-content center
	color #000
	text-align centers

.map-marker .disabled.warning
	background #ea8d8dff



