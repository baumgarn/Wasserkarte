// MARKER

.marker-outer
	opacity 0
.marker-outer.telemetryloaded
	opacity 1

.map-marker
	position: absolute;
	cursor pointer
	width: 20px;
	height: 20px;
	user-select: none
	transform: translate(-50%, -50%);
.map-marker.faux
	transform none
	position relative


.marker-container.mouseover
	z-index 1000

.marker-container
	overflow visible

// .marker-outer.filtered
// 	opacity 0
// 	pointer-events none
// 	*
// 		pointer-events none

.map-marker.alle
	width auto
	height auto
	filter: drop-shadow(0 0 2px rgba(0,0,0,.2));
	transform: translate(-50%, -4px);
	.schichten
		display flex
		flex-direction column
		border-radius 12px
		overflow hidden
		border 2px solid transparent
		.schicht
			display flex
			flex-direction row
			align-items flex-end
			justify-content flex-end
			padding 2px 6px 2px 9px
			&:first-child
				padding-top 4px
			&:last-child
				padding-bottom 4px
			.value
				flex-grow 0
				flex-shrink 0
				flex-basis auto
				white-space nowrap
				font-size 10pt
				text-align right
			.unit
				font-weight normal
				opacity .8
				font-size 90%
		.schicht + .schicht
			margin-top -1px

.map-marker.einzeln
	width auto
	height auto
	.schicht
		padding 2px 6px 2px 8px
		display flex
		flex-direction row
		border-radius 15px
		background wasserblau
		filter: drop-shadow(0 0 2px rgba(0,0,0,.2));
		border 2px solid transparent
		.value
			white-space nowrap
			.unit
				font-weight normal
				opacity .8
				font-size 95%

.map-marker.kreis
	width auto
	height auto
	.schichten
		border 2px solid #00000033
		filter: drop-shadow(0 1px 2px rgba(0,0,0,.3));
		width 36px
		height 36px
		border-radius 50%
		overflow hidden
		display flex
		flex-direction column
		cursor pointer
		.schicht
			flex-basis 50%
			width 100%
			flex-grow 1

.map-marker.property .propertyicon
	position relative
	left -8px
	top -8px
	width 36px
	height 36px
	filter drop-shadow(0 1px 2px rgba(0,0,0,.3))
	.icon
		border 2px solid #00000033
		border-radius 50%


.map-marker.selected .filtered
.map-marker.selected .disabled
.map-marker.selected .schichten
.map-marker.einzeln.selected .schicht
.map-marker.property.selected .propertyicon .icon
	border 2px solid #888
	outline 2px solid #ffffffdd
	filter: drop-shadow(0 1px 2px rgba(0,0,0,.45))

.map-marker .disabled
